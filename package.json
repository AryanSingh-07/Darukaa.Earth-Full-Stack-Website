{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "test": "npm --workspace frontend run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx}": [
      "eslint --fix --config frontend/eslint.config.js",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write",
    "backend/**/*.py": [
      "node scripts/run-python-tool.mjs ruff check --fix",
      "node scripts/run-python-tool.mjs ruff format"
    ]
  }
}
